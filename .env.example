# Runtime variable names consumed by the server. For GitHub Codespaces, store
# the first three values as GHCP_APP_CLIENT_ID, GHCP_APP_CLIENT_SECRET, and
# GHCP_SESSION_SECRET, then map them as documented in README.md.
GITHUB_APP_CLIENT_ID=your_github_app_client_id
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
GHCP_ENTERPRISE_BILLING_TOKEN=your_classic_pat_with_manage_billing_enterprise
SESSION_SECRET=your_strong_random_session_secret
CLIENT_ORIGIN=http://localhost:5173
CALLBACK_URL=http://localhost:5173/auth/github/callback
PORT=3001
