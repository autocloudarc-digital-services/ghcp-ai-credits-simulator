# Runtime variable names consumed by the server. For GitHub Codespaces, store
# the first three values as GHCP_APP_CLIENT_ID, GHCP_APP_CLIENT_SECRET, and
# GHCP_SESSION_SECRET, then map them as documented in README.md.
GITHUB_APP_CLIENT_ID=your_github_app_client_id
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret
GHCP_ENTERPRISE_BILLING_TOKEN=your_classic_pat_with_manage_billing_enterprise
SESSION_SECRET=your_strong_random_session_secret
CLIENT_ORIGIN=http://localhost:5173
CALLBACK_URL=http://localhost:5173/auth/github/callback
PORT=3001

# Register access is denied until an operator maps verified GitHub numeric IDs
# to a stable tenant ID and one role: reader, editor, or approver.
# Development can use .local/register-access.json when this variable is unset.
# An explicit value overrides that file; production never reads the local file.
REGISTER_ACCESS_JSON={}
# Local storage secrets are generated by npm run register:db:up in .local/.
# Production must set REGISTER_JWT_SECRET and REGISTER_GATEWAY_URL explicitly.
REGISTER_GATEWAY_URL=http://127.0.0.1:3302
